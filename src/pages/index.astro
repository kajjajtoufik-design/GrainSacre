---
import { getCollection } from 'astro:content';
import { SITE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts.find((p) => p.data.featured) || posts[0];
const others = posts.filter((p) => p.slug !== featured?.slug).slice(0, 2);
---

<BaseLayout>
  <!-- HERO -->
  <section class="relative grain overflow-hidden pt-28 pb-20 sm:pt-36 sm:pb-28 bg-gradient-to-b from-ivoire to-creme">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 grid lg:grid-cols-2 gap-12 items-center">
      <div class="relative z-10">
        <span class="reveal d1 inline-flex items-center gap-2 text-xs font-600 tracking-widest uppercase text-caramel mb-6">
          <span class="w-8 h-px bg-or"></span> {SITE.tagline}
        </span>
        <h1 class="reveal d2 font-display text-4xl sm:text-5xl lg:text-6xl font-600 leading-[1.05] tracking-tight">
          L'art du café,<br /><span class="italic text-caramel gold-underline">décrypté</span> pour vous.
        </h1>
        <p class="reveal d3 mt-6 text-lg text-moka/80 max-w-md leading-relaxed">
          Comparatifs indépendants, guides de torréfaction et conseils d'experts pour transformer chaque tasse en moment d'exception.
        </p>
        <div class="reveal d4 mt-8 flex flex-wrap gap-4">
          <a href="/comparateur/" class="inline-flex items-center gap-2 bg-espresso text-ivoire font-600 px-6 py-3.5 rounded-full hover:bg-moka transition-all hover:gap-3">
            Comparer les machines
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 9h10M10 5l4 4-4 4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </a>
          <a href="/blog/" class="inline-flex items-center gap-2 border border-espresso/25 px-6 py-3.5 rounded-full font-600 hover:border-or hover:text-caramel transition-colors">
            Lire le magazine
          </a>
        </div>
        <div class="reveal d5 mt-10 flex items-center gap-6 text-sm text-moka/70">
          <div><span class="font-display text-2xl font-600 text-espresso">120+</span><br />guides publiés</div>
          <div class="w-px h-10 bg-espresso/15"></div>
          <div><span class="font-display text-2xl font-600 text-espresso">8 200</span><br />abonnés</div>
          <div class="w-px h-10 bg-espresso/15"></div>
          <div><span class="font-display text-2xl font-600 text-espresso">100%</span><br />indépendant</div>
        </div>
      </div>
      <div class="reveal d3 relative">
        <div class="aspect-[4/5] rounded-[2rem] overflow-hidden shadow-2xl shadow-espresso/20 bg-moka">
          <img src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=1200&auto=format&fit=crop" alt="Tasse de café latte art sur une table en bois" class="w-full h-full object-cover" />
        </div>
        <div class="absolute -left-4 sm:-left-8 bottom-10 bg-ivoire rounded-2xl shadow-xl p-4 flex items-center gap-3 max-w-[220px] border border-espresso/5">
          <div class="w-11 h-11 rounded-full bg-sauge/20 flex items-center justify-center text-sauge text-xl">★</div>
          <div class="text-sm leading-tight"><span class="font-600 text-espresso">Top comparatif</span><br /><span class="text-moka/70">Espresso 2026</span></div>
        </div>
        <div class="absolute -right-3 top-8 w-20 h-20 rounded-full border border-or/40 bg-or/10 backdrop-blur-sm hidden sm:block"></div>
      </div>
    </div>
  </section>

  <!-- RÉASSURANCE -->
  <section class="border-y border-espresso/10 bg-ivoire">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-8 grid grid-cols-2 lg:grid-cols-4 gap-6 text-center">
      <div class="flex flex-col items-center gap-2"><span class="text-or text-2xl">⚖︎</span><p class="text-sm font-500 text-moka">Tests indépendants</p></div>
      <div class="flex flex-col items-center gap-2"><span class="text-or text-2xl">☕</span><p class="text-sm font-500 text-moka">Conseils d'experts</p></div>
      <div class="flex flex-col items-center gap-2"><span class="text-or text-2xl">↺</span><p class="text-sm font-500 text-moka">Mises à jour 2026</p></div>
      <div class="flex flex-col items-center gap-2"><span class="text-or text-2xl">✦</span><p class="text-sm font-500 text-moka">Sélection premium</p></div>
    </div>
  </section>

  <!-- DERNIERS ARTICLES -->
  <section id="articles" class="max-w-7xl mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
      <div>
        <span class="text-xs font-600 tracking-widest uppercase text-caramel">Le magazine</span>
        <h2 class="font-display text-3xl sm:text-4xl font-600 mt-2 tracking-tight">Derniers articles</h2>
      </div>
      <a href="/blog/" class="text-sm font-600 text-caramel hover:text-or transition-colors inline-flex items-center gap-1">Tout voir <span>→</span></a>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {featured && <ArticleCard post={featured} featured={true} />}
      {others.map((post) => <ArticleCard post={post} />)}
    </div>
  </section>

  <!-- SÉLECTION / AFFILIATION -->
  <section id="guides" class="bg-espresso text-creme py-20 sm:py-28 relative grain overflow-hidden">
    <div class="max-w-5xl mx-auto px-5 sm:px-8 text-center relative z-10">
      <span class="text-xs font-600 tracking-widest uppercase text-o1">Notre sélection</span>
      <h2 class="font-display text-3xl sm:text-4xl font-600 mt-3 tracking-tight">Le matériel qu'on recommande vraiment</h2>
      <p class="mt-4 text-creme/70 max-w-xl mx-auto">Chaque produit est testé par notre équipe. Les liens sont affiliés : ils nous soutiennent sans rien changer à votre prix.</p>
      <div class="mt-10 grid sm:grid-cols-3 gap-5 text-left">
        <div class="bg-moka/40 backdrop-blur rounded-2xl p-5 border border-creme/10 hover:border-or/40 transition-colors">
          <div class="aspect-square rounded-xl overflow-hidden mb-4 bg-creme/5"><img src="https://images.unsplash.com/photo-1572119865084-43c285814d63?q=80&w=600&auto=format&fit=crop" alt="Moulin à café manuel" class="w-full h-full object-cover" /></div>
          <p class="text-xs uppercase tracking-wider text-or">Moulin</p>
          <h3 class="font-display text-lg font-600 mt-1">Le moulin idéal débutant</h3>
          <a href="#" rel="sponsored nofollow noopener" class="mt-3 inline-flex text-sm font-600 text-or border border-or/40 px-4 py-2 rounded-full hover:bg-or hover:text-espresso transition-colors">Voir le prix ↗</a>
        </div>
        <div class="bg-moka/40 backdrop-blur rounded-2xl p-5 border border-creme/10 hover:border-or/40 transition-colors">
          <div class="aspect-square rounded-xl overflow-hidden mb-4 bg-creme/5"><img src="https://images.unsplash.com/photo-1517668808822-9ebb02f2a0e6?q=80&w=600&auto=format&fit=crop" alt="Balance de précision pour café" class="w-full h-full object-cover" /></div>
          <p class="text-xs uppercase tracking-wider text-or">Accessoire</p>
          <h3 class="font-display text-lg font-600 mt-1">La balance de précision</h3>
          <a href="#" rel="sponsored nofollow noopener" class="mt-3 inline-flex text-sm font-600 text-or border border-or/40 px-4 py-2 rounded-full hover:bg-or hover:text-espresso transition-colors">Voir le prix ↗</a>
        </div>
        <div class="bg-moka/40 backdrop-blur rounded-2xl p-5 border border-creme/10 hover:border-or/40 transition-colors">
          <div class="aspect-square rounded-xl overflow-hidden mb-4 bg-creme/5"><img src="https://images.unsplash.com/photo-1606791405792-1004f1718d0c?q=80&w=600&auto=format&fit=crop" alt="Cafetière design sur fond clair" class="w-full h-full object-cover" /></div>
          <p class="text-xs uppercase tracking-wider text-or">Cafetière</p>
          <h3 class="font-display text-lg font-600 mt-1">Notre coup de cœur slow</h3>
          <a href="#" rel="sponsored nofollow noopener" class="mt-3 inline-flex text-sm font-600 text-or border border-or/40 px-4 py-2 rounded-full hover:bg-or hover:text-espresso transition-colors">Voir le prix ↗</a>
        </div>
      </div>
    </div>
  </section>

  <Newsletter />
</BaseLayout>
