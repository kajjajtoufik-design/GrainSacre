---
// Encart d'affiliation à insérer dans un article.
// Utilisation dans un .mdx :  <AffiliateBox name="..." price="..." url="..." image="..." note="..." />
const { name, price, url, image, note = 'Notre recommandation' } = Astro.props;
---

<aside class="not-prose my-8 bg-espresso text-creme rounded-2xl p-5 flex flex-col sm:flex-row gap-5 items-center border border-or/20">
  {image && (
    <div class="w-32 h-32 rounded-xl overflow-hidden shrink-0 bg-moka/40">
      <img src={image} alt={name} loading="lazy" class="w-full h-full object-cover" />
    </div>
  )}
  <div class="flex-1 text-center sm:text-left">
    <p class="text-xs uppercase tracking-wider text-o1 font-600">{note}</p>
    <h4 class="font-display text-xl font-600 mt-1">{name}</h4>
    {price && <p class="font-display text-2xl font-600 text-o1 mt-1">{price}</p>}
  </div>
  <a
    href={url}
    rel="sponsored nofollow noopener"
    target="_blank"
    class="bg-or text-espresso font-700 px-6 py-3 rounded-full hover:bg-o1 transition-colors whitespace-nowrap"
    >Voir le prix ↗</a
  >
</aside>
