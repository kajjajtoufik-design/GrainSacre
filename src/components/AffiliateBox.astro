---
// ════════════════════════════════════════════════════════════
//  ENCART D'AFFILIATION
//
//  Deux façons de l'utiliser dans un article (.mdx) :
//
//  1) Par clé produit (recommandé — lit le fichier central produits.ts) :
//     <AffiliateBox cle="magnifica-s" />
//
//  2) En renseignant tout à la main :
//     <AffiliateBox nom="..." prix="..." url="..." image="..." note="..." />
//
//  Si l'URL est vide (produit pas encore affilié), le bouton affiche
//  "Bientôt disponible" et ne pointe nulle part — l'encart reste propre.
// ════════════════════════════════════════════════════════════
import { PRODUITS } from '../config/produits';

const { cle, nom, prix, url, image, note } = Astro.props;

// Si une clé est fournie, on récupère les infos du fichier central.
const p = cle ? PRODUITS[cle] : null;
const _nom = nom ?? p?.nom ?? '';
const _prix = prix ?? p?.prix ?? '';
const _url = url ?? p?.url ?? '';
const _image = image ?? p?.image ?? '';
const _note = note ?? p?.note ?? 'Notre recommandation';

const actif = Boolean(_url && _url.length > 0);
---

<aside class="not-prose my-8 bg-espresso text-creme rounded-2xl p-5 flex flex-col sm:flex-row gap-5 items-center border border-or/20">
  {_image && (
    <div class="w-32 h-32 rounded-xl overflow-hidden shrink-0 bg-moka/40">
      <img src={_image} alt={_nom} loading="lazy" class="w-full h-full object-cover" />
    </div>
  )}
  <div class="flex-1 text-center sm:text-left">
    <p class="text-xs uppercase tracking-wider text-o1 font-600">{_note}</p>
    <h4 class="font-display text-xl font-600 mt-1">{_nom}</h4>
    {_prix && <p class="font-display text-2xl font-600 text-o1 mt-1">{_prix}</p>}
  </div>

  {
    actif ? (
      <a
        href={_url}
        rel="sponsored nofollow noopener"
        target="_blank"
        class="bg-or text-espresso font-700 px-6 py-3 rounded-full hover:bg-o1 transition-colors whitespace-nowrap"
      >
        Voir le prix ↗
      </a>
    ) : (
      <span
        class="bg-creme/15 text-creme/60 font-600 px-6 py-3 rounded-full whitespace-nowrap cursor-default"
        title="Lien disponible prochainement"
      >
        Bientôt disponible
      </span>
    )
  }
</aside>
