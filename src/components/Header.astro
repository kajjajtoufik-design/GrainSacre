---
import { SITE, NAV_LINKS } from '../config/site';
---

<header class="fixed top-0 inset-x-0 z-50 bg-ivoire/80 backdrop-blur-md border-b border-espresso/10">
  <nav class="max-w-7xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between">
    <a href="/" class="font-display text-xl sm:text-2xl font-600 tracking-tight">
      {SITE.name}<span class="text-or">.</span>
    </a>
    <ul class="hidden md:flex items-center gap-8 text-sm font-600 text-moka">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} class="nav-link inline-flex items-center gap-1.5">
              {link.label}
              {link.badge && (
                <span class="text-[10px] font-700 bg-or/20 text-caramel px-1.5 py-0.5 rounded-full leading-none">
                  {link.badge}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="flex items-center gap-3">
      <a
        href="/#newsletter"
        class="hidden sm:inline-flex text-sm font-600 bg-espresso text-ivoire px-4 py-2 rounded-full hover:bg-moka transition-colors"
        >S'abonner</a
      >
      <button id="burger" class="md:hidden p-2 -mr-2" aria-label="Ouvrir le menu">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-espresso/10 bg-ivoire px-5 py-4 space-y-3 text-moka font-500"
  >
    {
      NAV_LINKS.map((link) => (
        <a href={link.href} class="flex items-center gap-1.5">
          {link.label}
          {link.badge && (
            <span class="text-[10px] font-700 bg-or/20 text-caramel px-1.5 py-0.5 rounded-full leading-none">
              {link.badge}
            </span>
          )}
        </a>
      ))
    }
  </div>
</header>

<script>
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobile-menu');
  burger?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
