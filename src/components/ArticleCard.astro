---
const { post, featured = false } = Astro.props;
const { title, description, image, imageAlt, category, readingTime, pubDate } = post.data;
const url = `/blog/${post.slug}/`;
const dateStr = new Date(pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---

{
  featured ? (
    <article class="md:col-span-2 md:row-span-2 group">
      <a href={url} class="block">
        <div class="aspect-[16/10] rounded-2xl overflow-hidden mb-5">
          <img src={image} alt={imageAlt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        </div>
        <span class="text-xs font-600 uppercase tracking-wider text-sauge">{category}</span>
        <h3 class="font-display text-2xl sm:text-3xl font-600 mt-2 leading-snug group-hover:text-caramel transition-colors">{title}</h3>
        <p class="mt-3 text-moka/75 leading-relaxed max-w-xl">{description}</p>
        <div class="mt-4 flex items-center gap-3 text-sm text-moka/60">
          <span>{readingTime} min de lecture</span><span>·</span><span>{dateStr}</span>
        </div>
      </a>
    </article>
  ) : (
    <article class="group flex gap-4 md:block">
      <a href={url} class="contents">
        <div class="w-28 h-28 md:w-full md:h-auto md:aspect-video rounded-xl overflow-hidden shrink-0 md:mb-4">
          <img src={image} alt={imageAlt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
        </div>
        <div>
          <span class="text-xs font-600 uppercase tracking-wider text-sauge">{category}</span>
          <h3 class="font-display text-lg font-600 mt-1 leading-snug group-hover:text-caramel transition-colors">{title}</h3>
        </div>
      </a>
    </article>
  )
}
