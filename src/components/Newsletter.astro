---
import { SITE } from '../config/site';
const action = SITE.newsletterAction || '#';
const field = SITE.newsletterField || 'EMAIL';
---

<section id="newsletter" class="bg-sauge/15 py-20 sm:py-28">
  <div class="max-w-3xl mx-auto px-5 sm:px-8 text-center">
    <div class="inline-flex w-14 h-14 rounded-full bg-sauge/25 items-center justify-center text-2xl mb-6">✉</div>
    <h2 class="font-display text-3xl sm:text-4xl font-600 tracking-tight">Recevez notre guide offert</h2>
    <p class="mt-4 text-moka/80 max-w-lg mx-auto">
      « Les 10 secrets d'un café parfait » + nos meilleurs comparatifs chaque semaine. Désinscription en un clic.
    </p>
    <form
      action={action}
      method="POST"
      target="_blank"
      class="mt-8 flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
    >
      <input
        type="email"
        name={field}
        required
        placeholder="votre@email.com"
        autocomplete="email"
        class="flex-1 px-5 py-3.5 rounded-full border border-espresso/20 bg-ivoire focus:outline-none focus:border-or focus:ring-2 focus:ring-or/20"
      />
      <button
        type="submit"
        class="bg-espresso text-ivoire font-600 px-7 py-3.5 rounded-full hover:bg-moka transition-colors whitespace-nowrap"
        >Je m'abonne</button
      >
    </form>
    <p class="text-xs text-moka/50 mt-4">Rejoignez 8 200 amateurs de café. Zéro spam.</p>
  </div>
</section>
